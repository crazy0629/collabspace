# Copy to server/.env (loaded automatically by `npm run dev` / `npm start`).
# On Render, set these in the service's Environment settings instead.

# Port the API listens on. Render injects PORT itself — don't set it there.
PORT=3001

# SQLite database file (created on first start). Relative paths resolve from the server folder.
DATABASE_PATH=./data/collabspace.db

# Comma-separated list of frontend origins allowed by CORS (exact match: scheme + host, no trailing slash).
# Production example: CORS_ORIGINS=https://collabspace.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create a few demo documents (shared between the demo users) on the very first start.
SEED_DEMO_DOCUMENTS=true

# Express "trust proxy": how many proxy hops sit in front of the API, so rate limiting sees the
# real client IP. Leave unset locally. On Render use 1. Never use "true" (clients could spoof IPs).
# TRUST_PROXY=1

# Rate limits per client IP (health checks are never limited).
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_API_MAX=1000
# RATE_LIMIT_IMPORT_MAX=20
