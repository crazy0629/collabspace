# Public URL of the CollabSpace API. VITE_* values are embedded in the browser bundle,
# so never put secrets here.
#
# - Dev server (`npm run dev`): optional, defaults to http://localhost:3001/api.
#   Override in client/.env.local.
# - Production builds (`npm run build`, Vercel): REQUIRED. The build fails if it is missing,
#   not an absolute URL, or not https (http is allowed only for localhost).
#   Set it in Vercel's Environment Variables, or in client/.env.production.local locally.
VITE_API_BASE_URL=http://localhost:3001/api
